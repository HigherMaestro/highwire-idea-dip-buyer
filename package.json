{
  "name": "dip-buyer",
  "private": true,
  "type": "module",
  "description": "An agent that waits for coins you picked to fall to a price you set, buys a small amount, then guards each position with a stop-loss and a take-profit.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/start.ts",
    "service": "node scripts/service.mjs",
    "setup": "node scripts/setup.mjs",
    "highwire": "node scripts/highwire.mjs",
    "orders": "node scripts/highwire.mjs orders run",
    "agent": "tsx src/agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "highwire-agent": "0.12.0",
    "highwire-mcp": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
